      "mcp__mcp-tg__tg_folders_list",
      "mcp__mcp-tg__tg_groups_info",
      "mcp__mcp-tg__tg_groups_invite_link_get",
      "mcp__mcp-tg__tg_groups_invite_link_list",
      "mcp__mcp-tg__tg_groups_list",
      "mcp__mcp-tg__tg_groups_members_list",
      "mcp__mcp-tg__tg_messages_context",
      "mcp__mcp-tg__tg_messages_get",
      "mcp__mcp-tg__tg_messages_get_reactions",
      "mcp__mcp-tg__tg_messages_get_scheduled",
      "mcp__mcp-tg__tg_messages_list",
      "mcp__mcp-tg__tg_messages_search",
      "mcp__mcp-tg__tg_messages_search_global",
      "mcp__mcp-tg__tg_messages_transcribe_audio",
      "mcp__mcp-tg__tg_profile_get",
      "mcp__mcp-tg__tg_server_version",
      "mcp__mcp-tg__tg_stickers_get_set",
      "mcp__mcp-tg__tg_stickers_search",
      "mcp__mcp-tg__tg_topics_list",
      "mcp__mcp-tg__tg_topics_search",
      "mcp__mcp-tg__tg_users_get",
      "mcp__mcp-tg__tg_users_get_common_chats",
      "mcp__mcp-tg__tg_users_get_photos"
    ],
    "ask": [
      "mcp__mcp-tg__tg_chats_archive",
      "mcp__mcp-tg__tg_chats_create",
      "mcp__mcp-tg__tg_chats_delete",
      "mcp__mcp-tg__tg_chats_mute",
      "mcp__mcp-tg__tg_chats_set_description",
      "mcp__mcp-tg__tg_chats_set_permissions",
      "mcp__mcp-tg__tg_chats_set_photo",
      "mcp__mcp-tg__tg_chats_set_send_as",
      "mcp__mcp-tg__tg_contacts_add",
      "mcp__mcp-tg__tg_contacts_delete",
      "mcp__mcp-tg__tg_dialogs_mark_unread",
      "mcp__mcp-tg__tg_dialogs_pin",
      "mcp__mcp-tg__tg_drafts_clear",
      "mcp__mcp-tg__tg_drafts_set",
      "mcp__mcp-tg__tg_folders_create",
      "mcp__mcp-tg__tg_folders_delete",
      "mcp__mcp-tg__tg_folders_edit",
      "mcp__mcp-tg__tg_groups_admin_set",
      "mcp__mcp-tg__tg_groups_invite_link_create",
      "mcp__mcp-tg__tg_groups_invite_link_revoke",
      "mcp__mcp-tg__tg_groups_join",
      "mcp__mcp-tg__tg_groups_leave",
      "mcp__mcp-tg__tg_groups_members_add",
      "mcp__mcp-tg__tg_groups_members_remove",
      "mcp__mcp-tg__tg_groups_rename",
      "mcp__mcp-tg__tg_groups_slowmode",
      "mcp__mcp-tg__tg_media_download",
      "mcp__mcp-tg__tg_media_send_album",
      "mcp__mcp-tg__tg_media_upload",
      "mcp__mcp-tg__tg_messages_clear_all_drafts",
      "mcp__mcp-tg__tg_messages_delete",
      "mcp__mcp-tg__tg_messages_delete_history",
      "mcp__mcp-tg__tg_messages_edit",
      "mcp__mcp-tg__tg_messages_forward",
      "mcp__mcp-tg__tg_messages_mark_read",
      "mcp__mcp-tg__tg_messages_pin",
      "mcp__mcp-tg__tg_messages_react",
      "mcp__mcp-tg__tg_messages_send",
      "mcp__mcp-tg__tg_messages_send_file",
      "mcp__mcp-tg__tg_online_status_set",
      "mcp__mcp-tg__tg_profile_set_bio",
      "mcp__mcp-tg__tg_profile_set_name",
      "mcp__mcp-tg__tg_profile_set_photo",
      "mcp__mcp-tg__tg_stickers_send",
      "mcp__mcp-tg__tg_topics_create",
      "mcp__mcp-tg__tg_topics_edit",
      "mcp__mcp-tg__tg_typing_send",
      "mcp__mcp-tg__tg_users_block"
    ]
  },
  "model": "opus",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~ && exec ${HOME}/.claude/hooks/notify.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~ && exec ${HOME}/.claude/hooks/bash.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "opus": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "iterm2_with_bell",
  "terminalProgressBarEnabled": false,
  "messageIdleNotifThresholdMs": 5000,
  "diffSidebarOpen": false,
  "showStatusInTerminalTab": false,
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
