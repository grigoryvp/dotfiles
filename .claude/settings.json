{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(mktemp:*)",
      "Bash(uv:*)",
      "Bash(yarn:*)",
      "Bash(find:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(./gradlew:*)",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_screenshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__navigate_page"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~ && exec ${HOME}/.claude/hooks/notify.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~ && exec ${HOME}/.claude/hooks/bash.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "iterm2_with_bell",
  "terminalProgressBarEnabled": false,
  "messageIdleNotifThresholdMs": 5000,
  "showStatusInTerminalTab": false
}
